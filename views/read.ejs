<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>All Users</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/styles/style.css" />
  </head>

  <body>
    <div class="main-bg min-h-screen p-10 text-white overflow-hidden">
      <div class="floating-circle one"></div>
      <div class="floating-circle two"></div>

      <div class="max-w-7xl mx-auto relative z-10">
        <div class="flex justify-between items-center mb-14 fade-down">
          <h1 class="text-5xl font-black gradient-text">All Users</h1>

          <a
            href="/"
            class="glass px-5 py-3 rounded-full hover:scale-105 transition"
          >
            ← Back
          </a>
        </div>

        <% if(users.length===0){ %>
        <div class="glass p-10 rounded-3xl text-center fade-up">
          <h2 class="text-3xl font-bold mb-3">No Users Found</h2>
        </div>
        <% } %>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
          <% users.forEach((user)=>{ %>

          <div class="user-card fade-up">
            <div class="image-wrapper">
              <img
                src="<%= user.image %>"
                alt=""
                class="user-image"
              />
            </div>

            <div class="p-6">
              <h2 class="text-2xl font-bold mb-2">
                <%= user.name %>
              </h2>

              <p class="text-zinc-400 mb-6 break-all">
                <%= user.email %>
              </p>

              <div class="flex gap-3">
                <a href="/edit/<%= user._id %>" class="edit-btn">
                  Edit
                </a>

                <a href="/delete/<%= user._id %>" class="delete-btn">
                  Delete
                </a>
              </div>
            </div>
          </div>

          <% }) %>
        </div>
      </div>
    </div>
  </body>
</html>