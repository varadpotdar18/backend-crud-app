<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Create User</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link rel="stylesheet" href="/styles/style.css" />
  </head>

  <body>
    <div class="main-bg min-h-screen p-10 text-white overflow-hidden">
      <div class="floating-circle one"></div>
      <div class="floating-circle two"></div>
      <div class="floating-circle three"></div>

      <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex justify-between items-center mb-16 fade-down">
          <h1 class="text-3xl font-bold logo-glow">UserHub</h1>

          <a
            href="/read"
            class="glass px-5 py-2 rounded-full hover:scale-105 transition"
          >
            View Users
          </a>
        </div>

        <div class="grid md:grid-cols-2 gap-16 items-center">
          <div class="fade-left">
            <h1 class="text-6xl font-black leading-tight mb-6">
              Build <span class="gradient-text">Beautiful</span> User Profiles
            </h1>

            <p class="text-zinc-300 text-lg leading-8 mb-8">
              Your first CRUD app with modern UI and animations.
            </p>
          </div>

          <div class="glass p-8 rounded-[2rem] fade-up">
            <h2 class="text-3xl font-bold mb-8 text-center">Create User</h2>

            <form action="/create" method="POST" class="flex flex-col gap-5">
              <input
                type="text"
                placeholder="Enter name"
                name="name"
                class="custom-input"
              />

              <input
                type="email"
                placeholder="Enter email"
                name="email"
                class="custom-input"
              />

              <input
                type="text"
                placeholder="Paste image URL"
                name="image"
                class="custom-input"
              />

              <button class="submit-btn">Create User</button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>